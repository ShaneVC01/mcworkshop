{
  // Cloudflare Workers serving the built static assets only. No Worker script in phase 1.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcworkshop",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Needed by `wrangler preview`, Cloudflare's default deploy command for non-production branches.
  // Empty because preview builds use the same settings as production.
  "previews": {}
}
